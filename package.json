{
  "name": "blog-generator-mcp",
  "version": "4.1.0",
  "description": "MCP server for automatic blog post generation using Gemini AI - supports multi-platform and interactive workflows",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "blog-generator-mcp": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "blog",
    "gemini",
    "claude",
    "ai",
    "automation",
    "interactive"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.1",
    "@google/generative-ai": "^0.21.0",
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@notionhq/client": "^5.9.0",
    "@octokit/rest": "^21.0.0",
    "commander": "^12.0.0",
    "express": "^4.18.2",
    "notion-to-md": "^3.1.9",
    "sql.js": "^1.10.0",
    "uuid": "^9.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/uuid": "^9.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
